# Earth Pulse SAR API — Environment Configuration Template
# Copy this file to .env and populate with your environment settings

# Server & Security
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
DEMO_MODE_RESTRICTED_EXECUTION=true

# Storage (Optional - defaults to ./data within project root)
# EARTH_PULSE_DATA_DIR=/path/to/earthpulse/data

# External Tool Paths (Required only if executing dynamic Sentinel-1 preprocessing with ESA SNAP)
# SNAP_GPT_PATH=/path/to/esa-snap/bin/gpt

# NASA Earthdata Authentication (Server-side only)
# Required only if executing dynamic Sentinel-1 satellite downloads
# EARTHDATA_USERNAME=your_earthdata_username
# EARTHDATA_PASSWORD=your_earthdata_password
