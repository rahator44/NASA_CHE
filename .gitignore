# ==============================================================================
# EarthPulse-SAR — .gitignore
# NASA Space Apps Challenge 2026 — Dancing with the SARs
# ==============================================================================

# Python bytecode and execution caches
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Virtual environments
.env
.venv
env/
venv/
ENV/

# Sensitive data and credentials
*.key
*.pem
*.token
*.p12
*.pfx
credentials.json
service_account.json
id_rsa
id_ed25519

# Operating System and IDE files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# Frontend Node & Vite build artifacts
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.test_build/

# Large archives and compressed packages
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
*.SAFE

# Large scientific rasters & raw satellite archives (Hosted on Google Drive)
data/raw/
data/runs/
data/cache/
data/temp/
.packages/
.earthdata-token
.netrc
*.env*
!.env.example
data/reference/
data/intermediate/
*.tif
*.tiff
*.jp2
*.img
*.hdr
*.dim
data/processed/**/*.tif
data/processed/**/*.img
data/processed/**/*.hdr
data/processed/**/*.dim

# Log files and runtime traces
*.log
logs/
*.tmp
*.bak
*.swp
*.local_backup
*.pre_phase8_4_backup
*.backup
*.db.local*
*.db
*.sqlite
*.sqlite3
data/metadata/*.db
data/metadata/*.sqlite*
data/metadata/*.backup*
data/metadata/*.dev_history_backup*

# Staging directories
EarthPulse-SAR-Scientific-Data/
research/

# ==============================================================================
# Whitelist / Explicit Inclusions
# ==============================================================================
!models/phase7a/phase7a_random_forest_model.joblib
!data/metadata/
!data/metadata/*.json
!data/outputs/**
!data/outputs/**/*.csv
!data/outputs/**/*.json
!data/outputs/**/*.geojson
!data/outputs/**/*.png
!data/outputs/**/*.jpg
!data/outputs/**/*.svg
!data/processed/**/*.geojson
!data/processed/**/*.json
